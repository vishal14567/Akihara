@model IEnumerable<Akihara.Models.TaskItem>
@{
    ViewData["Title"] = "Anime Merchandise, Manga & Figures Store";
}

<div class="store-hero-row">
    <!-- Categories Sidebar -->
    <aside class="store-sidebar">
        <div class="store-sidebar-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            All Categories
        </div>
        <ul class="store-sidebar-list">
            <li class="store-sidebar-item"><a href="#"><span>New Arrivals</span> <span class="store-tag tag-new">New</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Best Sellers</span> <span class="store-tag tag-hot">Hot</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Manga</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Figures</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Apparel</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Accessories</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Home & Decor</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Stationery</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Deals</span> <span class="store-tag tag-sale">Sale</span></a></li>
            <li class="store-sidebar-item"><a href="#"><span>Gift Cards</span></a></li>
        </ul>
    </aside>

    <!-- Carousel Banner -->
    <section class="store-hero-carousel" id="storeHeroCarousel">
        <div class="store-carousel-inner">
            <!-- Slide 1: Ichigo (STEP INTO ANOTHER WORLD) -->
            <div class="store-carousel-item active" data-index="0">
                <img src="~/img/Screenshot 2026-07-05 151209.png" class="store-carousel-img-bg" alt="Ichigo Banner">
                <div class="store-carousel-overlay">
                    <h1 class="store-hero-title">Step Into<br><span style="color:#FF3333;">Another World</span></h1>
                    <p class="store-hero-sub">Epic stories. Iconic characters.<br>Limitless adventures.</p>
                    <div class="store-hero-buttons">
                        <a href="#" class="store-btn-red">Shop Now</a>
                        <a href="#" class="store-btn-outline">View Collection</a>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Tanjiro (YOUR ANIME. YOUR PASSION.) -->
            <div class="store-carousel-item" data-index="1">
                <img src="~/img/Screenshot 2026-07-05 151315.png" class="store-carousel-img-bg" alt="Tanjiro Banner">
                <div class="store-carousel-overlay">
                    <h1 class="store-hero-title">Your Anime.<br><span style="color:#FF3333;">Your Passion.</span></h1>
                    <p class="store-hero-sub">Collect figures, merch,<br>manga & more.</p>
                    <div class="store-hero-buttons">
                        <a href="#" class="store-btn-red">Shop Now</a>
                        <a href="#" class="store-btn-outline">Browse Figures</a>
                    </div>
                </div>
            </div>

            <!-- Slide 3: Sasuke (LEGENDS LIVE FOREVER) -->
            <div class="store-carousel-item" data-index="2">
                <img src="~/img/Screenshot 2026-07-05 151412.png" class="store-carousel-img-bg" alt="Sasuke Banner">
                <div class="store-carousel-overlay">
                    <h1 class="store-hero-title">Legends<br>Live <span style="color:#FF3333;">Forever</span></h1>
                    <p class="store-hero-sub">From classics to new hits,<br>find it all here.</p>
                    <div class="store-hero-buttons">
                        <a href="#" class="store-btn-red">Shop Now</a>
                        <a href="#" class="store-btn-outline">New Arrivals</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Slider Navigation Controls -->
        <div class="store-carousel-control">
            <button class="store-carousel-arrow prev" id="carouselPrevBtn" title="Previous Banner">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button class="store-carousel-arrow next" id="carouselNextBtn" title="Next Banner">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>

        <!-- Indicators -->
        <div class="store-carousel-indicators">
            <button class="store-carousel-dot active" data-slide-to="0"></button>
            <button class="store-carousel-dot" data-slide-to="1"></button>
            <button class="store-carousel-dot" data-slide-to="2"></button>
        </div>
    </section>
</div>

<!-- Category Quick Links Row -->
<div class="category-links-grid">
    <!-- Category 1 -->
    <a href="#" class="category-quick-card">
        <img src="~/img/Screenshot 2026-07-05 203736.png" class="category-quick-icon" alt="Figures Category">
